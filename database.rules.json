{
  "rules": {
    ".read": false,
    ".write": false,
    "lobby": {
      "$mode": {
        ".read": "auth != null",
        "$room": { ".write": "auth != null" }
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || !data.child('pl').exists())",
        "mode":  { ".write": "auth != null && root.child('rooms/'+$room+'/host').val() === auth.uid" },
        "seed":  { ".write": "auth != null && root.child('rooms/'+$room+'/host').val() === auth.uid" },
        "state": { ".write": "auth != null && root.child('rooms/'+$room+'/host').val() === auth.uid" },
        "host": {
          ".write": "auth != null && (data.val() === auth.uid || !root.child('rooms/'+$room+'/pl/'+data.val()).exists())"
        },
        "pl": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('rooms/'+$room+'/host').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.hasChildren(['n','t','ts']) && newData.child('n').isString() && newData.child('n').val().length <= 14)"
          }
        },
        "st": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('rooms/'+$room+'/host').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.child('b').isString() && newData.child('b').val().length === 200)"
          },
          ".write": "auth != null && root.child('rooms/'+$room+'/host').val() === auth.uid"
        },
        "g": {
          ".write": "auth != null && root.child('rooms/'+$room+'/host').val() === auth.uid",
          "$target": {
            ".write": "auth != null",
            "$id": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20" }
          }
        }
      }
    }
  }
}
